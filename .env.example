# Dokploy injects production environment variables at runtime.
# PORT is set by the Docker image to 3000; expose that port in Dokploy.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/avant
AUTH_SECRET=replace-with-a-long-random-secret
AUTH_URL=https://your-domain.example.com
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-long-unique-password
